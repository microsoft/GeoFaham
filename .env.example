# =============================================================================
# GeoFaham Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables have sensible defaults except credentials.

# =============================================================================
# Azure OpenAI - Base Configuration
# =============================================================================

# Default endpoint (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# =============================================================================
# Azure Maps
# =============================================================================

# Subscription key for the Azure Maps account used by the frontend SDK.
# Find it in Azure portal -> your Azure Maps account -> Authentication.
AZURE_MAPS_KEY=

# =============================================================================
# Azure OpenAI - GPT-4o Model Configuration
# =============================================================================

AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_GPT4O_API_VERSION=2024-08-01-preview

# =============================================================================
# Azure OpenAI - GPT-5 / Reasoning Model Configuration
# =============================================================================

AZURE_OPENAI_GPT5_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_GPT5_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_GPT5_API_VERSION=2025-04-01-preview
AZURE_OPENAI_GPT5_MODEL=gpt-5.1-2025-11-13

# =============================================================================
# PostgreSQL / PostGIS Database
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geofaham
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# OpenStreetMap Services
# =============================================================================

# Local Nominatim instance for geocoding
OSM_NOMINATIM_URL=http://127.0.0.1:5060/nominatim/

# Local Overpass API instance
OSM_OVERPASS_URL=http://127.0.0.1:5060/overpass

# Cache folder for OSMnx
OSM_CACHE_FOLDER=/tmp/osmnx_cache

# =============================================================================
# File System Paths
# =============================================================================

# Runtime directory for generated artifacts, state, history (gitignored)
GEOFAHAM_BASE_DIR=./runtime

# Static data directory for reference files (STAC metadata, schemas)
GEOFAHAM_DATA_DIR=./data

# WorldPop raster file path (optional)
WORLDPOP_TIFF_PATH=

# Override specific paths (optional - defaults use the directories above)
STAC_BAND_METADATA_PATH=
TEAM_STATE_PATH=
CONVERSATION_HISTORY_PATH=
USER_DATA_PATH=
RESPONSE_STORE_PATH=
BENCHMARK_GT_PATH=

# =============================================================================
# Agent Model Selection
# =============================================================================

# Default model for simple agents (maps_agent, stac_agent)
GEOFAHAM_DEFAULT_MODEL=gpt-4o

# Reasoning model for complex agents (vector_agent, raster_agent, orchestrator)
GEOFAHAM_REASONING_MODEL=gpt-5.1

# Per-agent model overrides (optional - leave empty to use defaults above)
GEOFAHAM_VECTOR_AGENT_MODEL=
GEOFAHAM_MAPS_AGENT_MODEL=
GEOFAHAM_STAC_AGENT_MODEL=
GEOFAHAM_RASTER_AGENT_MODEL=

# Orchestrator uses two models: planner and progress tracker
GEOFAHAM_ORCHESTRATOR_PLANNER_MODEL=
GEOFAHAM_ORCHESTRATOR_PROGRESS_MODEL=

# =============================================================================
# Caching
# =============================================================================

# Cache TTL (Time To Live) in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Cache namespace (helps organize keys in Redis)
CACHE_NAMESPACE=qe_tiles
