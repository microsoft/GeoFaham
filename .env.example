# =============================================================================
# GeoFaham Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables have sensible defaults except credentials.

# =============================================================================
# Model Clients
# =============================================================================

# GeoFaham loads AutoGen ChatCompletionClient component configs directly.
# Any provider supported by your AutoGen install can be used here.
# Environment references like "$OPENAI_API_KEY" are expanded by GeoFaham.
# For OpenAI/Azure OpenAI clients, GeoFaham adds default model_info when omitted.
OPENAI_API_KEY=

# Positive execution limits (seconds). SQL is read-only; raster work runs in a stoppable process.
GEOFAHAM_SQL_TIMEOUT_SECONDS=60
GEOFAHAM_RASTER_TIMEOUT_SECONDS=300

# Simple agents use DEFAULT; vector/raster/orchestrator use REASONING.
GEOFAHAM_DEFAULT_MODEL_CLIENT={"provider":"autogen_ext.models.openai.OpenAIChatCompletionClient","config":{"model":"gpt-4o","api_key":"$OPENAI_API_KEY"}}
GEOFAHAM_REASONING_MODEL_CLIENT={"provider":"autogen_ext.models.openai.OpenAIChatCompletionClient","config":{"model":"gpt-5.1","api_key":"$OPENAI_API_KEY","reasoning_effort":"medium"}}

# Azure example:
# GEOFAHAM_DEFAULT_MODEL_CLIENT={"provider":"autogen_ext.models.openai.AzureOpenAIChatCompletionClient","config":{"model":"gpt-4o","azure_deployment":"gpt-4o","azure_endpoint":"https://your-resource.openai.azure.com/","api_version":"2024-08-01-preview","api_key":"$AZURE_OPENAI_KEY"}}

# Azure keyless (Microsoft Entra ID via DefaultAzureCredential) example:
# GEOFAHAM_DEFAULT_MODEL_CLIENT={"provider":"autogen_ext.models.openai.AzureOpenAIChatCompletionClient","config":{"model":"gpt-4o","azure_deployment":"gpt-4o","azure_endpoint":"https://your-resource.openai.azure.com/","api_version":"2024-08-01-preview","azure_ad_token_provider":{"provider":"autogen_ext.auth.azure.AzureTokenProvider","config":{"provider_kind":"DefaultAzureCredential","scopes":["https://cognitiveservices.azure.com/.default"]}}}}

# OpenAI-compatible endpoint example:
# GEOFAHAM_DEFAULT_MODEL_CLIENT={"provider":"autogen_ext.models.openai.OpenAIChatCompletionClient","config":{"model":"provider-model-name","base_url":"https://your-provider.example/v1","api_key":"$PROVIDER_API_KEY"}}

# =============================================================================
# Azure Maps
# =============================================================================

# Used by the frontend through /api/config.
AZURE_MAPS_KEY=

# =============================================================================
# PostgreSQL / PostGIS Database
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geofaham
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# OpenStreetMap Services
# =============================================================================

# Optional local/custom Nominatim instance for geocoding.
# Leave empty to use OSMnx defaults.
OSM_NOMINATIM_URL=

# Optional local/custom Overpass API instance.
# Leave empty to use OSMnx defaults.
OSM_OVERPASS_URL=

# Cache folder for OSMnx
OSM_CACHE_FOLDER=/tmp/osmnx_cache

# =============================================================================
# File System Paths
# =============================================================================

# Runtime directory for generated artifacts, state, history (gitignored)
GEOFAHAM_BASE_DIR=./runtime

# Static data directory for reference files (STAC metadata, schemas)
GEOFAHAM_DATA_DIR=./data

# WorldPop raster file path (optional)
WORLDPOP_TIFF_PATH=

# Override specific paths (optional - defaults use the directories above)
STAC_BAND_METADATA_PATH=
TEAM_STATE_PATH=
CONVERSATION_HISTORY_PATH=
USER_DATA_PATH=
RESPONSE_STORE_PATH=

# =============================================================================
# Agent Model Client Selection
# =============================================================================

# Per-agent overrides (optional - leave empty to use DEFAULT/REASONING above)
GEOFAHAM_VECTOR_AGENT_MODEL_CLIENT=
GEOFAHAM_MAPS_AGENT_MODEL_CLIENT=
GEOFAHAM_STAC_AGENT_MODEL_CLIENT=
GEOFAHAM_RASTER_AGENT_MODEL_CLIENT=

# Orchestrator uses two model clients: planner and progress tracker
GEOFAHAM_ORCHESTRATOR_PLANNER_MODEL_CLIENT=
GEOFAHAM_ORCHESTRATOR_PROGRESS_MODEL_CLIENT=

# =============================================================================
# Caching
# =============================================================================

# Cache TTL (Time To Live) in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Cache namespace (helps organize keys in Redis)
CACHE_NAMESPACE=qe_tiles

# =============================================================================
# Web Security
# =============================================================================

# Extra browser origins allowed to open /ws/chat and call uploads/reset.
# Same-origin requests are always allowed; leave empty unless the frontend is
# served from a different origin. Example: https://maps.example.com
GEOFAHAM_ALLOWED_ORIGINS=
# Extra HTTPS hosts the raster tile server may read, besides Planetary Computer
# and *.blob.core.windows.net. Use a leading dot for a domain suffix: .example.com
GEOFAHAM_RASTER_HOSTS=
